# Environment template for hrco.github.io
# Copy to .env (gitignored) and fill in this project's OWN values.

# xAI Grok API — get your key at https://x.ai/api
# Per-project key convention: this project uses its own XAI_API_KEY.
# xBridge/Grok launches via GROK/scripts/xbridge-launch.sh, which reads this file.
# Never inline keys in .mcp.json (gitignored & secret-free).
XAI_API_KEY=
